# Konfigurasi Database Vercel Postgres / Neon
# Jika dideploy ke Vercel dan dihubungkan ke Vercel Postgres / Neon Marketplace, variabel ini akan terisi otomatis.

POSTGRES_URL="postgres://default:password@ep-sample-pooler.us-east-1.aws.neon.tech:5432/verceldb?sslmode=require"
POSTGRES_PRISMA_URL="postgres://default:password@ep-sample-pooler.us-east-1.aws.neon.tech:5432/verceldb?sslmode=require&pgbouncer=true&connect_timeout=15"
POSTGRES_URL_NO_SSL="postgres://default:password@ep-sample-pooler.us-east-1.aws.neon.tech:5432/verceldb"
POSTGRES_URL_NON_POOLING="postgres://default:password@ep-sample-pooler.us-east-1.aws.neon.tech:5432/verceldb?sslmode=require"
POSTGRES_USER="default"
POSTGRES_HOST="ep-sample-pooler.us-east-1.aws.neon.tech"
POSTGRES_PASSWORD="password"
POSTGRES_DATABASE="verceldb"

# Catatan: Jika variabel di atas dikosongkan saat dijalankan secara lokal (npm run dev),
# aplikasi otomatis beralih ke SQLite lokal (portal.db) tanpa perlu konfigurasi tambahan.
